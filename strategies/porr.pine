//@version=6
// Pre-Open Range Reversal  -  Version 1.2
// v1.2: range-size label, dashed mid-range line, optional TP at the opposite range line.
// v1.1 defaults: TP 400 / SL 400, no breakeven, entry delay 24, 1 contract, max 4 trades,
//   trend TP 600 on 1h EMA50 (off), flip 100/100 (off).
// Marks the high/low of the hour before the cash open (default 07:30-08:30 Central,
// i.e. Oklahoma time) and fades the first touch of either level after the open:
//   touch range HIGH -> short, touch range LOW -> long.
// Fixed TP/SL in ticks, with an optional move-stop-to-breakeven once price runs
// a set number of ticks in your favor.
// Optional flip: if a fade is fully stopped out, rest a limit back at the broken line
// in the breakout direction to catch the retest.
// Use a 1-5 minute chart so the 07:30 / 08:30 boundaries line up with bar opens.
strategy("Pre-Open Range Reversal", shorttitle = "PORR", overlay = true,
     initial_capital = 50000, default_qty_type = strategy.fixed, default_qty_value = 1,
     margin_long = 0, margin_short = 0,
     commission_type = strategy.commission.cash_per_contract, commission_value = 0.7,
     // Limits must trade 1 tick THROUGH the level to fill (a bare touch is not a guaranteed fill).
     backtest_fill_limits_assumption = 1,
     // Use lower-timeframe data to resolve fills inside each chart bar (needs Premium+ plan).
     use_bar_magnifier = true,
     // Stats loop looks back over each trade's bars.
     max_bars_back = 2000,
     max_lines_count = 500, max_labels_count = 500)

// ---------- Inputs ----------
grpS = "Sessions"
tz        = input.string("America/Chicago", "Time zone", group = grpS, tooltip = "Oklahoma = America/Chicago (Central)")
rangeSess = input.session("0730-0830", "Range window (mark high/low)", group = grpS)
tradeSess = input.session("0830-1500", "Trade window (look for touches)", group = grpS)
flatAtEnd = input.bool(true, "Flatten open trade at end of trade window", group = grpS)

grpR = "Risk (ticks)"
tpTicks   = input.int(400, "Take profit (ticks)", minval = 1, group = grpR)
slTicks   = input.int(400, "Stop loss (ticks)", minval = 1, group = grpR)
useBE     = input.bool(false, "Use breakeven stop", group = grpR)
beTrigger = input.int(100, "Breakeven trigger (ticks in profit)", minval = 1, group = grpR)
beOffset  = input.int(3, "Breakeven offset (ticks beyond entry)", group = grpR, tooltip = "0 = stop exactly at entry. 3 = lock in 3 ticks.")

useLineTP = input.bool(false, "TP at the opposite range line", group = grpR, tooltip = "Overrides the take profit ticks (and the trend TP): longs from the range LOW take profit at the range HIGH, shorts from the range HIGH take profit at the range LOW, expecting the far line to act as resistance/support. Flip trades keep their own flip TP.")

grpF = "Trend filter (take profit)"
useTrendTP   = input.bool(false, "Use bigger TP on with-trend trades", group = grpF, tooltip = "Longs in an uptrend and shorts in a downtrend use the with-trend TP. Counter-trend trades keep the normal TP.")
tpTrendTicks = input.int(600, "With-trend take profit (ticks)", minval = 1, group = grpF)
trendTf      = input.timeframe("60", "Trend timeframe", group = grpF, tooltip = "Fixed timeframe so the trend reads the same on every chart timeframe. Keep it at or above the chart timeframe.")
trendLen     = input.int(50, "Trend EMA length", minval = 1, group = grpF, tooltip = "Uptrend = last closed trend-timeframe bar closed above its EMA. Downtrend = closed below.")
showTrend    = input.bool(false, "Show trend EMA", group = grpF)

grpX = "Flip trade (after stop-out)"
useFlip  = input.bool(false, "Flip after a full stop-out", group = grpX, tooltip = "If a Long from the range LOW is stopped out, rest a Short limit back at the range low (retest of the broken line). If a Short from the range HIGH is stopped out, rest a Long limit at the range high. One flip per line per day; counts toward max trades per day. A breakeven stop-out does not trigger a flip.")
flipTp   = input.int(100, "Flip take profit (ticks)", minval = 1, group = grpX)
flipSl   = input.int(100, "Flip stop loss (ticks)", minval = 1, group = grpX)

grpT = "Trade rules"
contracts   = input.int(1, "Contracts per trade", minval = 1, group = grpT)
maxTrades   = input.int(5, "Max trades per day", minval = 1, group = grpT)
onePerLevel = input.bool(true, "Only one trade per level per day", group = grpT)
allowLong   = input.bool(true, "Take longs (range low touch)", group = grpT)
allowShort  = input.bool(true, "Take shorts (range high touch)", group = grpT)
entryDelay  = input.int(24, "Entry delay (ticks beyond line)", minval = 0, group = grpT, tooltip = "Rests each limit this many ticks BEYOND the line: long below the range low, short above the range high. Read the dip stats with this at 0 first: above 0, trades that never dipped that far are not taken, so the stats only describe the deeper dips.")

grpV = "Visuals"
showLevels = input.bool(true, "Show range lines", group = grpV)
showRangeBg = input.bool(true, "Shade range window", group = grpV)
showMid     = input.bool(true, "Show mid-range line (dashed)", group = grpV)
showRngLbl  = input.bool(true, "Show range size label", group = grpV)
showStats   = input.bool(true, "Show stats table", group = grpV)
statsPosStr = input.string("Top right", "Stats table position", options = ["Top right", "Top left", "Bottom right", "Bottom left"], group = grpV)

// ---------- Session state ----------
tick    = syminfo.mintick
inRange = not na(time(timeframe.period, rangeSess, tz))
inTrade = not na(time(timeframe.period, tradeSess, tz))
// Orders placed at a bar's close work on the NEXT bar, so gate them on the next bar's session.
// This lets the limits rest from the 08:30 open instead of one bar late.
nextInRange = not na(time(timeframe.period, rangeSess, tz, -1))
nextInTrade = not na(time(timeframe.period, tradeSess, tz, -1))

// ---------- Trend ----------
// Uses the last CLOSED trend-timeframe bar ([1] + lookahead_on), so it never repaints.
[htfClose, htfEma] = request.security(syminfo.tickerid, trendTf, [close[1], ta.ema(close, trendLen)[1]], lookahead = barmerge.lookahead_on)
trendUp  = htfClose > htfEma
trendDn  = htfClose < htfEma
tpLongT  = useTrendTP and trendUp ? tpTrendTicks : tpTicks
tpShortT = useTrendTP and trendDn ? tpTrendTicks : tpTicks

var float rangeHigh = na
var float rangeLow  = na
var bool  rangeDone = false
var int   tradesToday = 0
var bool  longUsed  = false
var bool  shortUsed = false
var bool  flipLongArmed  = false   // short at range HIGH was stopped out -> long the retest of the high
var bool  flipShortArmed = false   // long at range LOW was stopped out  -> short the retest of the low
var bool  flipLongUsed   = false
var bool  flipShortUsed  = false

if inRange and not inRange[1]
    // New day's range starts: reset everything
    rangeHigh   := high
    rangeLow    := low
    rangeDone   := false
    tradesToday := 0
    longUsed    := false
    shortUsed   := false
    flipLongArmed  := false
    flipShortArmed := false
    flipLongUsed   := false
    flipShortUsed  := false
else if inRange
    rangeHigh := math.max(rangeHigh, high)
    rangeLow  := math.min(rangeLow, low)

// Range is final at the close of its last bar.
// barstate.isconfirmed: with "On history bar tick" enabled the script also runs inside each
// bar, so anything that must happen at a bar's CLOSE is gated on the bar being confirmed.
if inRange and not nextInRange and barstate.isconfirmed
    rangeDone := true

// ---------- Track fills ----------
totalTrades = strategy.closedtrades + strategy.opentrades
newTrade    = totalTrades > nz(totalTrades[1])
if newTrade
    tradesToday += totalTrades - nz(totalTrades[1])
    lastId = strategy.opentrades > 0 ? strategy.opentrades.entry_id(strategy.opentrades - 1) : strategy.closedtrades.entry_id(strategy.closedtrades - 1)
    switch lastId
        "Long"       => longUsed      := true
        "Short"      => shortUsed     := true
        "Flip Long"  => flipLongUsed  := true
        "Flip Short" => flipShortUsed := true

// A main trade that hit its FULL stop (not a breakeven stop) arms the flip for that line.
if strategy.closedtrades > nz(strategy.closedtrades[1])
    li    = strategy.closedtrades - 1
    lId   = strategy.closedtrades.entry_id(li)
    lEnt  = strategy.closedtrades.entry_price(li)
    lExit = strategy.closedtrades.exit_price(li)
    fullStop = strategy.closedtrades.exit_comment(li) == "SL"
    if fullStop and lId == "Long" and lExit <= lEnt - (slTicks - 1) * tick
        flipShortArmed := true
    if fullStop and lId == "Short" and lExit >= lEnt + (slTicks - 1) * tick
        flipLongArmed := true

// ---------- Entries ----------
flat       = strategy.position_size == 0
canTrade   = rangeDone and nextInTrade and flat and tradesToday < maxTrades and not na(rangeHigh) and not na(rangeLow)
// Only rest a limit when price is on the correct side of the level, so it fills on a touch
// rather than instantly at market (e.g. re-arming after being stopped out beyond the level).
longLvl    = rangeLow  - entryDelay * tick
shortLvl   = rangeHigh + entryDelay * tick
longReady  = canTrade and allowLong  and not (onePerLevel and longUsed)  and close > longLvl
shortReady = canTrade and allowShort and not (onePerLevel and shortUsed) and close < shortLvl

// Resting limit orders at the levels = "touch" entries. OCA so only one side fills.
if longReady
    strategy.entry("Long", strategy.long, qty = contracts, limit = longLvl, oca_name = "porr", oca_type = strategy.oca.cancel)
    if useLineTP
        strategy.exit("Long Exit", "Long", limit = rangeHigh, loss = slTicks, comment_profit = "TP", comment_loss = "SL")
    else
        strategy.exit("Long Exit", "Long", profit = tpLongT, loss = slTicks, comment_profit = "TP", comment_loss = "SL")
else
    strategy.cancel("Long")

if shortReady
    strategy.entry("Short", strategy.short, qty = contracts, limit = shortLvl, oca_name = "porr", oca_type = strategy.oca.cancel)
    if useLineTP
        strategy.exit("Short Exit", "Short", limit = rangeLow, loss = slTicks, comment_profit = "TP", comment_loss = "SL")
    else
        strategy.exit("Short Exit", "Short", profit = tpShortT, loss = slTicks, comment_profit = "TP", comment_loss = "SL")
else
    strategy.cancel("Short")

// Flip entries: resting limit back AT the broken line, waiting for price to retest it from the other side.
flipShortReady = useFlip and canTrade and flipShortArmed and not flipShortUsed and close < rangeLow
flipLongReady  = useFlip and canTrade and flipLongArmed  and not flipLongUsed  and close > rangeHigh

if flipShortReady
    strategy.entry("Flip Short", strategy.short, qty = contracts, limit = rangeLow, oca_name = "porr", oca_type = strategy.oca.cancel)
    strategy.exit("Flip Short Exit", "Flip Short", profit = flipTp, loss = flipSl, comment_profit = "TP", comment_loss = "SL")
else
    strategy.cancel("Flip Short")

if flipLongReady
    strategy.entry("Flip Long", strategy.long, qty = contracts, limit = rangeHigh, oca_name = "porr", oca_type = strategy.oca.cancel)
    strategy.exit("Flip Long Exit", "Flip Long", profit = flipTp, loss = flipSl, comment_profit = "TP", comment_loss = "SL")
else
    strategy.cancel("Flip Long")

// ---------- Exits / breakeven ----------
// Best price reached since the fill. With "On history bar tick" on, this updates on every
// simulated tick inside the bar, so the stop moves to breakeven intrabar (not at bar close).
entryPx = strategy.position_avg_price
var float bestHigh = na
var float bestLow  = na
var int   tradeTp  = na   // TP for the open trade, locked at entry (trend TP or flip TP)
var int   tradeSl  = na
var string tradeId = na
if strategy.position_size != 0
    entryBar = strategy.opentrades.entry_bar_index(strategy.opentrades - 1)
    if bar_index == entryBar
        tradeId := strategy.opentrades.entry_id(strategy.opentrades - 1)
        isFlip   = str.startswith(tradeId, "Flip")
        tradeTp := isFlip ? flipTp : strategy.position_size > 0 ? tpLongT : tpShortT
        tradeSl := isFlip ? flipSl : slTicks
        // On the entry bar the high/low may include price from BEFORE the fill. They are only
        // safe to use if the bar opened through the level (limit filled at the open);
        // otherwise use the current price, which is always after the fill.
        bestHigh := open <= entryPx ? high : math.max(entryPx, close)
        bestLow  := open >= entryPx ? low  : math.min(entryPx, close)
    else
        bestHigh := math.max(bestHigh, high)
        bestLow  := math.min(bestLow, low)

if strategy.position_size > 0
    tp = useLineTP and not str.startswith(tradeId, "Flip") ? rangeHigh : entryPx + nz(tradeTp, tpLongT) * tick
    sl = entryPx - nz(tradeSl, slTicks) * tick
    if useBE and bestHigh >= entryPx + beTrigger * tick
        sl := entryPx + beOffset * tick
    strategy.exit(tradeId + " Exit", tradeId, limit = tp, stop = sl, comment_profit = "TP", comment_loss = "SL")
else if strategy.position_size < 0
    tp = useLineTP and not str.startswith(tradeId, "Flip") ? rangeLow : entryPx - nz(tradeTp, tpShortT) * tick
    sl = entryPx + nz(tradeSl, slTicks) * tick
    if useBE and bestLow <= entryPx - beTrigger * tick
        sl := entryPx - beOffset * tick
    strategy.exit(tradeId + " Exit", tradeId, limit = tp, stop = sl, comment_profit = "TP", comment_loss = "SL")

if flatAtEnd and inTrade and not nextInTrade and barstate.isconfirmed
    strategy.close_all(comment = "EOD")

// ---------- Visuals ----------
showLine = showLevels and rangeDone and inTrade
plot(showLine ? rangeHigh : na, "Range High", color.red, 2, plot.style_linebr)
plot(showLine ? rangeLow  : na, "Range Low", color.green, 2, plot.style_linebr)

// Dashed grey mid-range line and a range-size label above the top line, both following the
// current bar to the right while the trade window is open (one of each per day).
var line  midLine = na
var label rngLbl  = na
if showLine and not showLine[1]
    rangeTicks = (rangeHigh - rangeLow) / tick
    if showMid
        midLine := line.new(bar_index, (rangeHigh + rangeLow) / 2, bar_index, (rangeHigh + rangeLow) / 2, color = color.gray, style = line.style_dashed, width = 1)
    if showRngLbl
        rngLbl := label.new(bar_index, rangeHigh, "Range " + str.tostring(rangeHigh - rangeLow, format.mintick) + " pts (" + str.tostring(rangeTicks, "#") + " ticks)", style = label.style_label_lower_left, color = color.new(color.black, 100), textcolor = color.red, size = size.small)
if showLine
    if not na(midLine)
        line.set_x2(midLine, bar_index)
    if not na(rngLbl)
        label.set_x(rngLbl, bar_index)
if not showLine and showLine[1]
    midLine := na
    rngLbl  := na
bgcolor(showRangeBg and inRange ? color.new(color.blue, 88) : na, title = "Range window")

posLong  = strategy.position_size > 0
posShort = strategy.position_size < 0
plot(posLong or posShort ? entryPx : na, "Entry", color.gray, 1, plot.style_linebr)
plot(showTrend ? htfEma : na, "Trend EMA", trendUp ? color.teal : color.orange, 2)

// ---------- End of day ----------
// Retire the day's levels when the trade window closes, so a day with no range bars
// (holiday / missing data) can't trade off yesterday's stale levels.
if inTrade and not nextInTrade and barstate.isconfirmed
    rangeDone := false

// ---------- Stats ----------
// One record per closed trade: entry time, winner?, hit TP?, and the dip = how many ticks price went
// BEYOND the range line (below the low for longs, above the high for shorts) while in the trade.
var array<int>   stTime = array.new<int>()
var array<bool>  stTP   = array.new<bool>()
var array<bool>  stWin  = array.new<bool>()
var array<float> stDip  = array.new<float>()
var array<bool>  stMain = array.new<bool>()   // false = flip trade (excluded from dip averages)
var array<float> stPnl  = array.new<float>()
var array<bool>  stLong = array.new<bool>()
var int processed = 0
var int firstTime = time

if barstate.isconfirmed and strategy.closedtrades > processed
    for i = processed to strategy.closedtrades - 1
        isLong = strategy.closedtrades.size(i) > 0
        entP   = strategy.closedtrades.entry_price(i)
        exP    = strategy.closedtrades.exit_price(i)
        eBar   = strategy.closedtrades.entry_bar_index(i)
        xBar   = strategy.closedtrades.exit_bar_index(i)
        // TP exits are tagged "TP" (works for both the normal and the with-trend TP)
        isTP   = strategy.closedtrades.exit_comment(i) == "TP"
        isEOD  = strategy.closedtrades.exit_comment(i) == "EOD"
        // Entry bar: everything before a limit fill is on the far side of the entry, so the
        // bar's low (long) / high (short) is after the fill and safe to use.
        worst = isLong ? low[bar_index - eBar] : high[bar_index - eBar]
        if xBar > eBar
            // (Pine for-loops count DOWN if end < start, so guard the empty case)
            if xBar - eBar > 1
                for b = eBar + 1 to xBar - 1
                    worst := isLong ? math.min(worst, low[bar_index - b]) : math.max(worst, high[bar_index - b])
            // Exit bar: only count price from before the exit.
            //  TP    -> skip it (the extreme may come after the TP fill)
            //  stop  -> price can't have gone past the stop before it filled
            //  EOD   -> exit is at the close, whole bar counts
            xLow  = low[bar_index - xBar]
            xHigh = high[bar_index - xBar]
            if isEOD
                worst := isLong ? math.min(worst, xLow) : math.max(worst, xHigh)
            else if not isTP
                worst := isLong ? math.min(worst, math.max(xLow, exP)) : math.max(worst, math.min(xHigh, exP))
        dip = isLong ? (rangeLow - worst) / tick : (worst - rangeHigh) / tick
        // Windows use ENTRY time, like the Strategy Tester's date range.
        array.push(stTime, strategy.closedtrades.entry_time(i))
        array.push(stTP, isTP)
        // Same definition as the Strategy Tester's "Profitable trades" (net of commission).
        array.push(stWin, strategy.closedtrades.profit(i) > 0)
        array.push(stDip, dip)
        array.push(stMain, not str.startswith(strategy.closedtrades.entry_id(i), "Flip"))
        array.push(stPnl, strategy.closedtrades.profit(i))
        array.push(stLong, isLong)
    processed := strategy.closedtrades

// Stats for closed trades entered in the last `days` calendar days (days = 0 -> all trades).
f_stats(int days) =>
    cutoff = days > 0 ? time - days * 86400000 : 0
    int   n      = 0
    int   nWin   = 0
    int   nTP    = 0
    int   nMain  = 0
    int   nMainTP = 0
    float sumTP  = 0.0
    float sumAll = 0.0
    int   nFlip    = 0
    int   nFlipWin = 0
    int   nFlipTP  = 0
    float flipPnl  = 0.0
    int   nL  = 0
    int   nLW = 0
    int   nS  = 0
    int   nSW = 0
    sz = array.size(stTime)
    if sz > 0
        for i = 0 to sz - 1
            if array.get(stTime, i) >= cutoff
                n += 1
                isMain = array.get(stMain, i)
                if array.get(stWin, i)
                    nWin += 1
                if array.get(stTP, i)
                    nTP += 1
                // Long/short split includes flips (same as the Strategy Tester's Long/Short columns)
                if array.get(stLong, i)
                    nL += 1
                    nLW += array.get(stWin, i) ? 1 : 0
                else
                    nS += 1
                    nSW += array.get(stWin, i) ? 1 : 0
                if isMain
                    nMain  += 1
                    sumAll += array.get(stDip, i)
                    if array.get(stTP, i)
                        nMainTP += 1
                        sumTP   += array.get(stDip, i)
                else
                    nFlip   += 1
                    flipPnl += array.get(stPnl, i)
                    if array.get(stWin, i)
                        nFlipWin += 1
                    if array.get(stTP, i)
                        nFlipTP += 1
    // "*" = the chart's loaded history is shorter than this window
    partial = days > 0 and firstTime > cutoff
    avgTP  = nMainTP > 0 ? sumTP / nMainTP : na
    avgAll = nMain > 0 ? sumAll / nMain : na
    [n, nWin, nTP, avgTP, avgAll, partial, nFlip, nFlipWin, nFlipTP, flipPnl, nL, nLW, nS, nSW]

f_fmt(float v) => na(v) ? "-" : str.tostring(v, "#.#")

statsPos = switch statsPosStr
    "Top left"     => position.top_left
    "Bottom right" => position.bottom_right
    "Bottom left"  => position.bottom_left
    => position.top_right

var table stats = table.new(statsPos, 5, 14, bgcolor = color.new(color.black, 20), border_color = color.gray, border_width = 1, frame_color = color.gray, frame_width = 1)

if showStats and barstate.islast
    [n7,  w7,  tp7,  sTP7,  sA7,  p7,  f7,  fw7,  ft7,  fp7,  l7,  lw7,  s7,  sw7 ] = f_stats(7)
    [n30, w30, tp30, sTP30, sA30, p30, f30, fw30, ft30, fp30, l30, lw30, s30, sw30] = f_stats(30)
    [n90, w90, tp90, sTP90, sA90, p90, f90, fw90, ft90, fp90, l90, lw90, s90, sw90] = f_stats(90)
    [nAl, wAl, tpAl, sTPAl, sAAl, pAl, fAl, fwAl, ftAl, fpAl, lAl, lwAl, sAl, swAl] = f_stats(0)
    lNs  = array.from(l7, l30, l90, lAl)
    lWs  = array.from(lw7, lw30, lw90, lwAl)
    sNs  = array.from(s7, s30, s90, sAl)
    sWs  = array.from(sw7, sw30, sw90, swAl)
    fNs  = array.from(f7, f30, f90, fAl)
    fWs  = array.from(fw7, fw30, fw90, fwAl)
    fTs  = array.from(ft7, ft30, ft90, ftAl)
    fPs  = array.from(fp7, fp30, fp90, fpAl)
    ns   = array.from(n7, n30, n90, nAl)
    ws   = array.from(w7, w30, w90, wAl)
    tps  = array.from(tp7, tp30, tp90, tpAl)
    sTPs = array.from(sTP7, sTP30, sTP90, sTPAl)
    sAs  = array.from(sA7, sA30, sA90, sAAl)
    ps   = array.from(p7, p30, p90, pAl)
    hdrs = array.from("7 days", "30 days", "90 days", "All")
    txt  = color.white
    table.cell(stats, 0, 0, "Metric", text_color = txt, text_halign = text.align_left)
    table.cell(stats, 0, 1, "Trades taken", text_color = txt, text_halign = text.align_left)
    table.cell(stats, 0, 2, "Win % (profitable)", text_color = txt, text_halign = text.align_left)
    table.cell(stats, 0, 3, "% TP", text_color = txt, text_halign = text.align_left)
    table.cell(stats, 0, 4, "Long W / L", text_color = txt, text_halign = text.align_left)
    table.cell(stats, 0, 5, "Long win %", text_color = txt, text_halign = text.align_left)
    table.cell(stats, 0, 6, "Short W / L", text_color = txt, text_halign = text.align_left)
    table.cell(stats, 0, 7, "Short win %", text_color = txt, text_halign = text.align_left)
    table.cell(stats, 0, 8, "Avg dip beyond line, TP trades (ticks, excl. flips)", text_color = txt, text_halign = text.align_left)
    table.cell(stats, 0, 9, "Avg dip beyond line, all trades (ticks, excl. flips)", text_color = txt, text_halign = text.align_left)
    table.cell(stats, 0, 10, "Flip trades taken", text_color = txt, text_halign = text.align_left)
    table.cell(stats, 0, 11, "Flip win % (profitable)", text_color = txt, text_halign = text.align_left)
    table.cell(stats, 0, 12, "Flip % TP", text_color = txt, text_halign = text.align_left)
    table.cell(stats, 0, 13, "Flip net P&L ($)", text_color = txt, text_halign = text.align_left)
    for c = 0 to 3
        fn = array.get(fNs, c)
        fp = array.get(fPs, c)
        table.cell(stats, c + 1, 10, str.tostring(fn), text_color = txt)
        table.cell(stats, c + 1, 11, fn > 0 ? str.tostring(100.0 * array.get(fWs, c) / fn, "#.#") + "%" : "-", text_color = txt)
        table.cell(stats, c + 1, 12, fn > 0 ? str.tostring(100.0 * array.get(fTs, c) / fn, "#.#") + "%" : "-", text_color = txt)
        table.cell(stats, c + 1, 13, fn > 0 ? str.tostring(fp, "#,##0.00") : "-", text_color = fn == 0 ? txt : fp >= 0 ? color.lime : color.red)
        n  = array.get(ns, c)
        tp = array.get(tps, c)
        table.cell(stats, c + 1, 0, array.get(hdrs, c) + (array.get(ps, c) ? "*" : ""), text_color = txt)
        table.cell(stats, c + 1, 1, str.tostring(n), text_color = txt)
        table.cell(stats, c + 1, 2, n > 0 ? str.tostring(100.0 * array.get(ws, c) / n, "#.#") + "%" : "-", text_color = txt)
        table.cell(stats, c + 1, 3, n > 0 ? str.tostring(100.0 * tp / n, "#.#") + "%" : "-", text_color = txt)
        ln = array.get(lNs, c)
        lw = array.get(lWs, c)
        sn = array.get(sNs, c)
        sw = array.get(sWs, c)
        table.cell(stats, c + 1, 4, str.tostring(lw) + " / " + str.tostring(ln - lw), text_color = txt)
        table.cell(stats, c + 1, 5, ln > 0 ? str.tostring(100.0 * lw / ln, "#.#") + "%" : "-", text_color = txt)
        table.cell(stats, c + 1, 6, str.tostring(sw) + " / " + str.tostring(sn - sw), text_color = txt)
        table.cell(stats, c + 1, 7, sn > 0 ? str.tostring(100.0 * sw / sn, "#.#") + "%" : "-", text_color = txt)
        table.cell(stats, c + 1, 8, f_fmt(array.get(sTPs, c)), text_color = txt)
        table.cell(stats, c + 1, 9, f_fmt(array.get(sAs, c)), text_color = txt)
